{
  "collectionName": "components_landing_page_component_event_hero_simples",
  "info": {
    "displayName": "Event Hero Simple",
    "description": "Content-only hero for event pages: background, event information and CTA buttons (no video or image). Enter `date` as the event's own local time — it is shown exactly as typed, with the `timeZone` value as the label (5:30 PM + PT renders '5:30 PM PT'). No timezone conversion is applied. Set `hubspotFormId` to put a registration form in the hero, below the CTAs; it renders as a single row when the HubSpot form has one field."
  },
  "options": {},
  "attributes": {
    "sectionTag": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime"
    },
    "timeZone": {
      "type": "enumeration",
      "enum": [
        "ET",
        "CT",
        "MT",
        "PT",
        "IST",
        "GMT"
      ],
      "default": "ET"
    },
    "hubspotFormId": {
      "type": "string"
    },
    "ctaButton": {
      "type": "component",
      "repeatable": false,
      "component": "elements.button"
    },
    "secondaryButton": {
      "type": "component",
      "repeatable": false,
      "component": "elements.button"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "backgroundColor": {
      "type": "string"
    }
  }
}
