{
  "kind": "singleType",
  "collectionName": "global_ads_banners",
  "info": {
    "singularName": "global-ads-banner",
    "pluralName": "global-ads-banners",
    "displayName": "Global Ads Banner",
    "description": "Site-wide header/footer banner. Unlike event pages, `date` here is a real point in time and IS converted into `timeZone` before display (15:00 UTC + ET renders '11:00 AM ET')."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "tag": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "primaryButton": {
      "type": "component",
      "repeatable": false,
      "component": "elements.button"
    },
    "date": {
      "type": "datetime"
    },
    "backgroundTheme": {
      "type": "enumeration",
      "enum": [
        "hero-gradient-purple-blue",
        "hero-gradient-warm",
        "hero-gradient-cool",
        "hero-gradient-full"
      ],
      "default": "hero-gradient-purple-blue"
    },
    "timeZone": {
      "type": "enumeration",
      "enum": [
        "ET",
        "CT",
        "MT",
        "PT",
        "IST",
        "GMT"
      ],
      "default": "ET"
    }
  }
}
